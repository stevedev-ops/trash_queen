{
  "version": 2,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "s-maxage=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/googlec80406e3045698dc.html",
      "dest": "/googlec80406e3045698dc.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

