        "Content-Type": "text/plain; charset=utf-8"
      },
      "dest": "/llms.txt"
    },
    {
      "src": "/llms-full.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "dest": "/llms-full.txt"
    },
    {
      "src": "/.well-known/security.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "dest": "/.well-known/security.txt"
    },
    {
